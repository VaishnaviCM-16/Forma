{
  "name": "forma-collaborative-canvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm:dev:server\" \"pnpm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0 --port 3000",
    "build": "pnpm typecheck && pnpm compile:server && vite build && pnpm prerender",
    "start": "node dist-server/index.js",
    "compile:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "tsx scripts/smoke-sync.ts",
    "prerender": "tsx scripts/prerender.ts",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "lib0": "0.2.119",
    "ws": "8.22.1",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.7",
    "framer-motion": "14.10.1",
    "jsdom": "31.0.0",
    "lucide-react": "1.70.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
